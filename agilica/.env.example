# DJI developer app credentials.
#
# Copy this file to `.env` and fill in the values from your app registration at
# https://developer.dji.com/user/apps . `.env` is gitignored - keep it that way,
# the license string is tied to your DJI developer account.
#
# psdk_wrapper's psdk_connect() refuses to call DjiCore_Init unless the first
# five are all set (see extracted_gnc/src/psdk_wrapper/src/psdk_wrapper.c).

PSDK_APP_NAME=""
PSDK_APP_ID=""
PSDK_APP_KEY=""
PSDK_APP_LICENSE=""
PSDK_DEV_ACCOUNT=""

# Must match the baud rate configured on the E-Port adapter.
PSDK_BAUD_RATE="460800"

# Host-side serial devices. Normally leave these alone: scripts/detect_serial.sh resolves
# both by USB product string (FTDI TTL232R-3V3 for the aircraft, FTDI FT231X for the UWB
# module), which survives them swapping ttyUSB indices depending on plug order.
#
# To pin a port, export it in the shell rather than setting it here:
#
#     PSDK_UART_DEV=/dev/ttyUSB3 ./start_demo.sh
#
# Setting it in this file has no effect: start_demo.sh exports the port it detected, and
# docker compose gives the shell environment precedence over .env, so the detected value
# always wins over a line here.
#
#PSDK_UART_DEV="/dev/ttyUSB0"    # aircraft payload UART  (see note above)
#UWB_UART_DEV="/dev/ttyUSB1"     # Agilica UWB module - /dev/ttyUSBn, NOT ttyACM0
