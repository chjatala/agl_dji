# DJI developer app credentials.
#
# Copy this file to `.env` and fill in the values from your app registration at
# https://developer.dji.com/user/apps . `.env` is gitignored - keep it that way,
# the license string is tied to your DJI developer account.
#
# psdk_wrapper's psdk_connect() refuses to call DjiCore_Init unless the first
# five are all set (see extracted_gnc/src/psdk_wrapper/src/psdk_wrapper.c).

PSDK_APP_NAME=""
PSDK_APP_ID=""
PSDK_APP_KEY=""
PSDK_APP_LICENSE=""
PSDK_DEV_ACCOUNT=""

# Must match the baud rate configured on the E-Port adapter.
PSDK_BAUD_RATE="460800"

# Host-side serial device for the UART link to the aircraft's payload port.
# Kept off /dev/ttyACM0, which the Agilica UWB unit uses.
PSDK_UART_DEV="/dev/ttyUSB0"
