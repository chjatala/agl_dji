{
  "configById": {
    "Gauge!battery": {
      "path": "/dji/battery.percentage",
      "minValue": 0,
      "maxValue": 1,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "gradient": ["#f44336", "#4caf50"],
      "reverse": false
    },
    "Plot!attitude": {
      "title": "Attitude (quaternion, body-FRD -> ground-NED)",
      "paths": [
        { "value": "/dji/drone/attitude.quaternion.w", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/drone/attitude.quaternion.x", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/drone/attitude.quaternion.y", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/drone/attitude.quaternion.z", "enabled": true, "timestampMethod": "receiveTime" }
      ],
      "minYValue": -1.1,
      "maxYValue": 1.1,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "Plot!uwbtrack": {
      "title": "UWB track (Y vs X, top-down)",
      "paths": [
        { "value": "/agilica_pose.pose.position.y", "enabled": true, "timestampMethod": "receiveTime" }
