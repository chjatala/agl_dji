        { "value": "/agilica_pose.pose.position.z", "enabled": true, "timestampMethod": "receiveTime" }
      ],
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "Plot!velocity": {
      "title": "Velocity body-FRD (m/s)",
      "paths": [
        { "value": "/dji/drone/spd.vector.x", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/drone/spd.vector.y", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/drone/spd.vector.z", "enabled": true, "timestampMethod": "receiveTime" }
      ],
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "Plot!height": {
      "title": "Height above ground (m) + WGS-84 altitude",
      "paths": [
        { "value": "/dji/height_from_ground.range", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/drone/pos.position.altitude", "enabled": true, "timestampMethod": "receiveTime" }
      ],
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "Plot!setpoint": {
      "title": "Commanded velocity setpoint (m/s)",
      "paths": [
        { "value": "/dji/cmd/drone/setpoint.velocity.x", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/cmd/drone/setpoint.velocity.y", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/cmd/drone/setpoint.velocity.z", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/dji/cmd/drone/setpoint.yaw", "enabled": true, "timestampMethod": "receiveTime" }
