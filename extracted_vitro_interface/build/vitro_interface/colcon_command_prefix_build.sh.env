AMENT_PREFIX_PATH=/root/ros2_ws/install/vitro_ros_definitions:/opt/ros/humble
CMAKE_PREFIX_PATH=/root/ros2_ws/install/vitro_ros_definitions
COLCON=1
HOME=/root
LANG=C.UTF-8
LC_ALL=C.UTF-8
LD_LIBRARY_PATH=/root/ros2_ws/install/vitro_ros_definitions/lib:/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib
NVIDIA_DRIVER_CAPABILITIES=graphics
NVIDIA_VISIBLE_DEVICES=all
OLDPWD=/root/ros2_ws
PATH=/opt/ros/humble/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/root/ros2_ws/build/vitro_interface
PYTHONPATH=/root/ros2_ws/install/vitro_ros_definitions/local/lib/python3.10/dist-packages:/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
ROS_DISTRO=humble
ROS_LOCALHOST_ONLY=0
ROS_PYTHON_VERSION=3
ROS_VERSION=2
SHLVL=0
_=/usr/bin/colcon
